{
  "name": "hello-mike",
  "version": "0.13.4",
  "description": "Hello Mike Stage4 stable Windows installer test",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "socks": "^2.8.7"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.hellomike.desktop",
    "productName": "Hello Mike",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Hello-Mike-Setup-${version}.${ext}",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hello Mike",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}